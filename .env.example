# =============================================================================
# Plantilla de variables de entorno de referencia (Cero Secretos)
# Copiar este archivo a .env antes de levantar los contenedores:
#   cp .env.example .env (o Copy-Item .env.example .env en PowerShell)
#
# IMPORTANTE: El archivo .env NUNCA debe commitearse al repositorio Git.
# =============================================================================

# --- PostgreSQL 16 (HU-04) ---------------------------------------------------
POSTGRES_DB=tpfinalbackend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_seguro_aqui
POSTGRES_PORT=5432

# --- Backend Node.js / Express 5 (HU-11) -------------------------------------
BACKEND_PORT=3000
JWT_SECRET=tu_jwt_secret_seguro_aqui
SESSION_SECRET=tu_session_secret_seguro_aqui
FRONTEND_URL=http://localhost:4200

# Integraciones externas del Backend (Opcionales para ejecución local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
GEMINI_API_KEY=

# --- Frontend Angular 21 (HU-11) ---------------------------------------------
FRONTEND_PORT=4200

# --- General -----------------------------------------------------------------
TZ=America/Argentina/Buenos_Aires
