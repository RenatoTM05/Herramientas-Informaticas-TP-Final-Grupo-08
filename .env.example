# =============================================================================
# Archivo de referencia de variables de entorno
# Copiar a .env  ->  cp .env.example .env  y completar con valores reales
# =============================================================================
# --- PostgreSQL 16 (HU-04) ---------------------------------------------------
POSTGRES_DB=tpfinalbackend
POSTGRES_USER=gamer_admin
POSTGRES_PASSWORD=CAMBIAR_ESTA_CLAVE
POSTGRES_PORT=5433

# --- pgAdmin4 (HU-05) --------------------------------------------------------
# El email debe tener formato válido; será el login de pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=CAMBIAR_ESTA_CLAVE
PGADMIN_PORT=5050

# --- Zona horaria ------------------------------------------------------------
TZ=America/Argentina/Buenos_Aires