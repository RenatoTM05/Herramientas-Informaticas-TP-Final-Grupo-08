# =============================================================================
# Plantilla de Variables de Entorno de Referencia (Cero Secretos)
# Proyecto: Red Social Gamer - Grupo 08
# Copiar este archivo a .env antes de levantar los contenedores:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# IMPORTANTE: El archivo .env NUNCA debe commitearse al repositorio Git.
# =============================================================================

# --- PostgreSQL 16 (Motor Relacional - HU-04) --------------------------------
POSTGRES_DB=tpfinalbackend
POSTGRES_USER=gamer_admin
POSTGRES_PASSWORD=clavePgPostgre
POSTGRES_PORT=5433
# HU-09/10: generar una contraseña distinta para el rol de replicación.
PATRONI_REPLICATION_PASSWORD=

# --- Backups automáticos (HU-07) --------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7

# --- pgAdmin4 (Administración Web BD - HU-05) --------------------------------
# El email debe tener formato válido; será el login de acceso a pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=clavePgAdmin
PGADMIN_PORT=5050

# --- Backend API Node.js / Express 5 (HU-11) ---------------------------------
BACKEND_PORT=3000
JWT_SECRET=token_pal_usuario
SESSION_SECRET=session_user
FRONTEND_URL=http://localhost:4200

# Integraciones externas del Backend (Opcionales para ejecución local básica)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
GEMINI_API_KEY=

# --- Frontend Web Angular 21 (HU-11) -----------------------------------------
FRONTEND_PORT=4200
# Clave de autenticación del nodo Tailscale (configurar localmente; nunca versionar)
TS_AUTHKEY=

# --- GLPI & MariaDB (Mesa de Ayuda Helpdesk - HU-15) -------------------------
GLPI_DB_ROOT_PASSWORD=root_password_change_me
GLPI_DB_NAME=glpi_db
GLPI_DB_USER=glpi_user
GLPI_DB_PASSWORD=glpi_password_change_me
GLPI_PORT=8080

# --- Configuración General / Zona Horaria ------------------------------------
TZ=America/Argentina/Buenos_Aires

# ------------------------------HU-17 | Nextcloud Documental & Base de Datos Dedicada-------------------
NEXTCLOUD_PORT=8085
NEXTCLOUD_DB_NAME=nextcloud_db
NEXTCLOUD_DB_USER=nextcloud_user
NEXTCLOUD_DB_PASSWORD=nextcloud_password_change_me
NEXTCLOUD_ADMIN_USER=admin_nextcloud
NEXTCLOUD_ADMIN_PASSWORD=admin_password_change_me

# --- HU-14 | Monitoreo & Observabilidad (Prometheus & Grafana) -----------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin_grafana
GRAFANA_ADMIN_PASSWORD=grafana_password_change_me

# --- HU-18 | n8n Orquestador de Automatizaciones ------------------------------
N8N_PORT=5678
N8N_ENCRYPTION_KEY=super_secret_encryption_key_grupo08
ALERTMANAGER_PORT=9093