    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || $json;\nconst alerts = body.alerts || [];\nconst alert = alerts[0] || {};\nconst labels = alert.labels || {};\nconst annotations = alert.annotations || {};\n\n// Mapear severidad de Prometheus a Urgencia de GLPI (1: Muy baja ... 5: Muy alta)\nlet urgency = 3; // Media\nif (labels.severity === 'critical') {\n  urgency = 5; // Muy alta\n} else if (labels.severity === 'warning') {\n  urgency = 4; // Alta\n}\n\nconst alertName = labels.alertname || 'Alerta de Infraestructura Desconocida';\nconst summary = annotations.summary || alertName;\nconst description = annotations.description || 'Sin descripción disponible';\nconst status = alert.status || 'firing';\n\nreturn {\n  alertName,\n  summary,\n  description,\n  severity: labels.severity || 'warning',\n  urgency,\n  status,\n  ticketTitle: `[ALERTA INFRAESTRUCTURA] ${summary}`,\n  ticketContent: `Se ha detectado una anomalía automática reportada por Prometheus Alertmanager.<br><br><b>Alerta:</b> ${alertName}<br><b>Severidad:</b> ${labels.severity}<br><b>Estado:</b> ${status}<br><b>Detalle:</b> ${description}<br><b>Fecha:</b> ${new Date().toISOString()}`\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -304,
